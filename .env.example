# ---------------------------------------------------------------------------
# Sellerboard Walmart export
#
#   cp .env.example .env        (Linux: chmod 600 .env)
#
# .env is git-ignored. Exported environment variables win over it.
# ---------------------------------------------------------------------------

# --- Sellerboard -----------------------------------------------------------
SELLERBOARD_BASE_URL=https://app.sellerboard.com
SELLERBOARD_MARKETPLACE=walmart
SELLERBOARD_EMAIL=Power.bi@itrendsolution.com
SELLERBOARD_PASSWORD=
# Fill the login form automatically when the saved session expires.
SELLERBOARD_AUTO_LOGIN=true

# --- What to download --------------------------------------------------------
# Oldest day to backfill. Periods are downloaded newest first, back to this.
# 2025-01-01 covers last year + this year; new days (into next year) are
# picked up automatically by every scheduled run.
BACKFILL_START_DATE=2025-01-01
# One file per: day | week | month
PERIOD_GRANULARITY=day
# Today is still changing; by default the newest period is yesterday.
INCLUDE_TODAY=false
# Re-download periods ending in the last N days on every run -- Walmart
# refunds and fees arrive 14-28 days late, ad cost 1-2 days late.
REFRESH_RECENT_DAYS=30
# Cap downloads per run (0 = no cap). Useful to spread the first backfill.
MAX_PERIODS_PER_RUN=0
PAUSE_BETWEEN_DOWNLOADS_SECONDS=3
MAX_CONSECUTIVE_FAILURES=5
# Defines "today"/"yesterday" -- use the Sellerboard account's timezone.
REPORT_TIMEZONE=America/Los_Angeles

# --- MySQL -------------------------------------------------------------------
# Every downloaded period is loaded into MySQL. The tool creates and owns the
# table (default sellerboard_<marketplace>_daily / _weekly / _monthly).
# Set DB_ENABLED=false to download files only.
DB_ENABLED=true
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# DB_TABLE=sellerboard_walmart_daily
# TLS: point DB_SSL_CA at a CA bundle when the server requires it.
# DB_SSL_CA=certs/ca.pem
DB_SSL_VERIFY_CERT=false
DB_SSL_DISABLED=false
DB_CONNECT_TIMEOUT_SECONDS=30

# --- Paths (relative to the project root) -----------------------------------
DOWNLOAD_DIR=data/downloads
SCREENSHOT_DIR=data/screenshots
STATE_DIR=data/state
LOG_DIR=logs
# Chromium profile holding the logged-in session. Treat as a secret.
SESSION_DIR=data/session
LOCK_FILE=data/sellerboard.lock

# --- Browser -----------------------------------------------------------------
HEADLESS=true
BROWSER_TIMEOUT_MS=60000
DOWNLOAD_TIMEOUT_MS=180000
# Extra wait after the dashboard goes idle, so tiles finish rendering.
PAGE_SETTLE_MS=3000
SLOW_MO_MS=0
BROWSER_ARGS=
BROWSER_NO_SANDBOX=false

# --- Retry -------------------------------------------------------------------
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
RETRY_BACKOFF_MAX_SECONDS=120

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
SCREENSHOT_RETENTION_DAYS=14
